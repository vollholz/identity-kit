     "def": "CREATE OR REPLACE FUNCTION app.entra_login_alias(p_domain text)\n RETURNS text\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'assets', 'pg_temp'\nAS $function$\nDECLARE prev text := coalesce(current_setting('app.entra_scan', true), ''); v text;\nBEGIN\n  PERFORM set_config('app.entra_scan', 'on', true);\n  SELECT c.idp_alias INTO v FROM assets.entra_connection c JOIN assets.tenant t ON t.id = c.tenant_id\n   WHERE lower(p_domain) = ANY (c.domains) AND c.stage = 'enforced' AND t.status = 'active' LIMIT 1;\n  PERFORM set_config('app.entra_scan', prev, true);\n  RETURN v;\nEND $function$\n",
