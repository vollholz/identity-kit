     "args": "p_id uuid, p_status text",
     "owner": "assets_owner",
     "def": "CREATE OR REPLACE FUNCTION app.set_tenant_status(p_id uuid, p_status text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'assets', 'pg_temp'\nAS $function$\nBEGIN\n  IF p_status NOT IN ('active', 'suspended') THEN RAISE EXCEPTION 'Status % ungültig', p_status USING ERRCODE = '22023'; END IF;\n  UPDATE assets.tenant SET status = p_status WHERE id = p_id;\n  IF NOT FOUND THEN RAISE EXCEPTION 'Mandant % nicht gefunden', p_id USING ERRCODE = 'P0002'; END IF;\nEND $function$\n",
