{
  "name": "@vollholz/iam-testkit",
  "version": "2.4.5",
  "description": "Tests für Apps mit dem IAM-Baukasten: Wegwerf-Datenbank, Mock-IdP, Keycloak-Nachbildung, RLS-, Katalog- und Isolationsprüfungen, Konformitätstest (iam-conformity-test)",
  "type": "module",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/vollholz/identity-kit.git", "directory": "packages/iam-testkit" },
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema/identity-app.schema.json": "./schema/identity-app.schema.json",
    "./schema/operator-defaults.schema.json": "./schema/operator-defaults.schema.json",
    "./package.json": "./package.json"
  },
  "bin": { "iam-conformity-test": "dist/bin/conformity-test.js" },
  "files": ["dist", "schema", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "jose": "6.2.12"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "pg": "8.23.1"
  }
}
