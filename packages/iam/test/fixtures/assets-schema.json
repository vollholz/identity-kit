   "audit_hash": [
    {
     "args": "prev bytea, r assets.audit_log",
     "owner": "assets_owner",
     "def": "CREATE OR REPLACE FUNCTION app.audit_hash(prev bytea, r assets.audit_log)\n RETURNS bytea\n LANGUAGE sql\n IMMUTABLE\nAS $function$\n  SELECT sha256(convert_to(\n    coalesce(encode(prev, 'hex'), '') || '|' ||\n    jsonb_build_array(\n      2, r.tenant_id, r.seq,\n      to_char(r.ts AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"'),\n      r.actor_kind, r.actor_id, r.actor_name, r.client_id, r.source,\n      r.action, r.resource_type, r.resource_id, r.correlation_id, r.data\n    )::text, 'UTF8'))\n$function$\n",
     "secdef": false,
     "config": null,
     "acl": null,
     "volatile": "i"
    }
   ],
   "audit_chain": [
    {
     "args": "",
     "owner": "assets_owner",
     "def": "CREATE OR REPLACE FUNCTION app.audit_chain()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nDECLARE last record;\nBEGIN\n  -- Sperre bis Transaktionsende: Einträge eines Mandanten werden strikt nacheinander verkettet.\n  PERFORM pg_advisory_xact_lock(hashtextextended('audit:' || NEW.tenant_id::text, 0));\n  SELECT seq, hash INTO last FROM assets.audit_log WHERE tenant_id = NEW.tenant_id ORDER BY seq DESC LIMIT 1;\n  NEW.ts := date_trunc('microseconds', NEW.ts);\n  NEW.seq := coalesce(last.seq, 0) + 1;\n  NEW.prev_hash := last.hash;\n  NEW.hash := app.audit_hash(NEW.prev_hash, NEW);\n  RETURN NEW;\nEND $function$\n",
     "secdef": false,
     "config": null,
     "acl": null,
     "volatile": "v"
    }
   ],
