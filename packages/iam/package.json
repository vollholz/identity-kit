{
  "name": "@vollholz/iam",
  "version": "0.1.0",
  "private": true,
  "description": "Anmeldung und Rechte für Apps auf der Identity-Plattform: Token-Prüfung, Principal, BFF, Entscheidung mit dem Katalog der App, Verwaltung, Migrationen",
  "type": "module",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/vollholz/identity-kit.git", "directory": "packages/iam" },
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "migrations", "db", "README.md"],
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec 'test/**/*.test.ts'"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@vollholz/iam-testkit": "0.1.0",
