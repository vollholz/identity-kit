{
  "name": "@vollholz/iam",
  "version": "1.0.0",
  "description": "Anmeldung und Rechte für Apps auf der Identity-Plattform: Token-Prüfung, Principal, BFF, Entscheidung mit dem Katalog der App, Verwaltung, Migrationen",
  "type": "module",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/vollholz/identity-kit.git", "directory": "packages/iam" },
  "engines": { "node": ">=24" },
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "./package.json": "./package.json" },
  "bin": { "iam-org-bootstrap": "dist/bin/org-bootstrap.js" },
  "files": ["dist", "migrations", "db", "docs/backend.md", "README.md"],
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec $(ls test/*.test.ts | grep -v -x -e test/acl.test.ts -e test/roles.test.ts -e test/assets-schema.test.ts -e test/catalog.test.ts)"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "jose": "6.2.12",
    "openid-client": "6.8.8"
  },
  "peerDependencies": {
    "@fastify/cookie": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": { "optional": true }
  },
  "devDependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/swagger": "9.9.1",
    "@opentelemetry/api": "1.9.1",
    "@vollholz/iam-testkit": "1.0.0",
    "fastify": "5.12.6",
    "pg": "8.23.1"
  }
}
