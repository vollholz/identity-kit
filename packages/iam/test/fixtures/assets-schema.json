     "def": "CREATE OR REPLACE FUNCTION app.entra_free_slot(p_max integer)\n RETURNS text\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'assets', 'pg_temp'\nAS $function$\nDECLARE prev text := coalesce(current_setting('app.entra_scan', true), ''); v text;\nBEGIN\n  PERFORM set_config('app.entra_scan', 'on', true);\n  SELECT format('entra-%s', lpad(n::text, 3, '0')) INTO v FROM generate_series(1, least(greatest(p_max, 0), 999)) n\n   WHERE NOT EXISTS (SELECT 1 FROM assets.entra_connection c WHERE c.idp_alias = format('entra-%s', lpad(n::text, 3, '0')))\n   ORDER BY n LIMIT 1;\n  PERFORM set_config('app.entra_scan', prev, true);\n  RETURN v;\nEND $function$\n",
