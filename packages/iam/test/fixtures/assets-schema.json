   "secure_tenant_tables": [
    {
     "args": "",
     "owner": "assets_owner",
     "def": "CREATE OR REPLACE FUNCTION app.secure_tenant_tables()\n RETURNS integer\n LANGUAGE plpgsql\nAS $function$\nDECLARE t text; n int := 0;\nBEGIN\n  FOR t IN SELECT c.table_name FROM information_schema.columns c\n           JOIN information_schema.tables x ON x.table_schema = c.table_schema AND x.table_name = c.table_name AND x.table_type = 'BASE TABLE'\n           WHERE c.table_schema = 'assets' AND c.column_name = 'tenant_id' AND c.table_name <> 'tenant'\n  LOOP\n    EXECUTE format('ALTER TABLE assets.%I ENABLE ROW LEVEL SECURITY', t);\n    EXECUTE format('ALTER TABLE assets.%I FORCE ROW LEVEL SECURITY', t);\n    IF NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname = 'assets' AND tablename = t AND policyname = 'tenant_isolation') THEN\n      EXECUTE format('CREATE POLICY tenant_isolation ON assets.%I TO assets_app USING (tenant_id = app.tenant_id()) WITH CHECK (tenant_id = app.tenant_id())', t);\n      EXECUTE format('GRANT SELECT, INSERT, UPDATE, DELETE ON assets.%I TO assets_app', t);\n      n := n + 1;\n    END IF;\n  END LOOP;\n  EXECUTE 'GRANT USAGE ON ALL SEQUENCES IN SCHEMA assets TO assets_app, assets_sched';\n  RETURN n;\nEND $function$\n",
     "secdef": false,
     "config": null,
     "acl": null,
     "volatile": "v"
    }
   ],
   "resolve_tenant": [
    {
     "args": "p_alias text, p_kc_org_id text, p_name text, p_create boolean",
     "owner": "assets_owner",
     "def": "CREATE OR REPLACE FUNCTION app.resolve_tenant(p_alias text, p_kc_org_id text, p_name text, p_create boolean)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'assets', 'pg_temp'\nAS $function$\nDECLARE v_id uuid; v_status text; v_kc text;\nBEGIN\n  SELECT id, status, kc_org_id INTO v_id, v_status, v_kc FROM assets.tenant WHERE alias = lower(p_alias);\n  IF v_id IS NULL AND p_create THEN\n    INSERT INTO assets.tenant (alias, kc_org_id, name) VALUES (lower(p_alias), p_kc_org_id, coalesce(p_name, p_alias))\n      ON CONFLICT (alias) DO UPDATE SET alias = excluded.alias RETURNING id, status, kc_org_id INTO v_id, v_status, v_kc;\n  END IF;\n  IF v_status = 'suspended' THEN RETURN NULL; END IF;\n  IF v_id IS NOT NULL AND p_kc_org_id IS NOT NULL THEN\n    IF v_kc IS NULL THEN\n      UPDATE assets.tenant SET kc_org_id = p_kc_org_id WHERE id = v_id AND kc_org_id IS NULL AND NOT EXISTS (SELECT 1 FROM assets.tenant WHERE kc_org_id = p_kc_org_id);\n    ELSIF v_kc <> p_kc_org_id THEN RETURN NULL;\n    END IF;\n  END IF;\n  RETURN v_id;\nEND $function$\n",
     "secdef": true,
     "config": [
      "search_path=assets, pg_temp"
     ],
     "acl": [
      "assets_app=X/assets_owner",
      "assets_owner=X/assets_owner"
     ],
     "volatile": "v"
    }
   ],
   "bump_acl_version": [
    {
     "args": "",
     "owner": "assets_owner",
     "def": "CREATE OR REPLACE FUNCTION app.bump_acl_version()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'assets', 'pg_temp'\nAS $function$\nBEGIN\n  UPDATE assets.tenant SET acl_version = acl_version + 1 WHERE id = coalesce(NEW.tenant_id, OLD.tenant_id);\n  RETURN NULL;\nEND $function$\n",
     "secdef": true,
     "config": [
      "search_path=assets, pg_temp"
     ],
     "acl": [
