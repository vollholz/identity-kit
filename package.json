{
  "name": "identity-kit",
  "private": true,
  "type": "module",
  "description": "Baukasten für Anmeldung und Rechte (authn, authz) von Apps mit Keycloak",
  "engines": { "node": ">=24" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
