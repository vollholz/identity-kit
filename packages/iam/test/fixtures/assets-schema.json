     "def": "CREATE OR REPLACE FUNCTION app.entra_domains_taken(p_domains text[])\n RETURNS text[]\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'assets', 'pg_temp'\nAS $function$\nDECLARE prev text := coalesce(current_setting('app.entra_scan', true), ''); v text[];\nBEGIN\n  IF app.tenant_id() IS NULL THEN RETURN NULL; END IF;\n  PERFORM set_config('app.entra_scan', 'on', true);\n  SELECT coalesce(array_agg(DISTINCT d ORDER BY d), '{}') INTO v FROM assets.entra_connection c, unnest(c.domains) d\n   WHERE c.tenant_id <> app.tenant_id() AND d = ANY (p_domains);\n  PERFORM set_config('app.entra_scan', prev, true);\n  RETURN v;\nEND $function$\n",
